# 배포 백엔드 주소 또는 같은 Wi-Fi의 개발 PC 주소를 입력하세요.
# 실제 휴대폰에서 localhost/127.0.0.1은 휴대폰 자신을 뜻합니다.
EXPO_PUBLIC_API_BASE_URL=http://10.100.0.73:8000
# 선택: /api/stream/url이 준비되지 않은 환경에서 웹 VITE_STREAM_URL처럼 폴백할 스트림 주소
EXPO_PUBLIC_STREAM_URL=

# Google Cloud Console에서 앱 패키지/번들 ID에 맞는 OAuth 클라이언트를 발급하세요.
# Android package: com.aimyaong.mobile
# iOS bundle ID: com.aimyaong.mobile
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1034586846978-d24vdc078j1ae041c1d77anqrc3s005j.apps.googleusercontent.com

# 선택: ESP32가 AP 모드로 제공하는 설정 서버
EXPO_PUBLIC_ESP32_SETUP_URL=http://192.168.4.1
