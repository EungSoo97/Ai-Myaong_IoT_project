MJPEG_STREAM_URL=http://raspberrypi.local:8080/stream.mjpg
MQTT_BROKER_HOST=raspberrypi.local
MQTT_BROKER_PORT=1883

# Flip camera output horizontally when the camera needs mirror correction.
VISION_FLIP_HORIZONTAL=true

# Vision activity test settings
ACTIVITY_WINDOW_SECONDS=60
ACTIVITY_NO_MOTION_THRESHOLD=0.002
ACTIVITY_LOW_THRESHOLD=0.01
ACTIVITY_ACTIVE_THRESHOLD=0.04
ACTIVITY_MIN_DETECTED_RATIO=0.2
ACTIVITY_MOVEMENT_DEADZONE=0.006
ACTIVITY_SCORE_SCALE=50

# Emergency detection. Reduce the no-motion times only while testing.
EMERGENCY_ENABLED=true
EMERGENCY_COOLDOWN_SECONDS=60
EMERGENCY_MISSING_GRACE_SECONDS=2
FALL_WINDOW_SECONDS=0.7
FALL_DROP_RATIO=0.10
FALL_CONFIRM_SECONDS=1.2
FALL_STILL_THRESHOLD=0.006
EMERGENCY_NO_MOTION_WARNING_SECONDS=600
EMERGENCY_NO_MOTION_EMERGENCY_SECONDS=900
EMERGENCY_NO_MOTION_CENTER_THRESHOLD=0.002
EMERGENCY_NO_MOTION_ROI_THRESHOLD=0.015

# Emergency clips: keep 5 seconds before detection and 8 seconds after detection.
# Away-mode person clips use the same clip window settings.
EMERGENCY_CLIP_PRE_SECONDS=5
EMERGENCY_CLIP_POST_SECONDS=8
EMERGENCY_CLIP_FPS=10
EMERGENCY_CLIP_JPEG_QUALITY=80
VISION_DB_API_TIMEOUT=3

# Minimum seconds between away-mode person alerts/clips.
AWAY_PERSON_EVENT_COOLDOWN=10

# 발작 의심 - 현재 영상 검증용 값
SEIZURE_WINDOW_SECONDS=3
SEIZURE_ROI_MOTION_THRESHOLD=0.05
SEIZURE_CENTER_MOTION_THRESHOLD=0.025
SEIZURE_HIGH_MOTION_RATIO=0.60

# 발작 의심 - 실제 운영 후보값 (정상 행동 오탐 검증 후 전환)
# SEIZURE_WINDOW_SECONDS=3
# SEIZURE_ROI_MOTION_THRESHOLD=0.075
# SEIZURE_CENTER_MOTION_THRESHOLD=0.012
# SEIZURE_HIGH_MOTION_RATIO=0.60

# Optional local video file for desktop/opencv/activity_video_test.py
VIDEO_TEST_PATH=

# Optional local video and detector-time multiplier for emergency_video_test.py
EMERGENCY_VIDEO_TEST_PATH=
EMERGENCY_TEST_TIME_SCALE=1
