# API and realtime services
VITE_API_BASE_URL=https://myaong-production-d3b8.up.railway.app
# Optional. Defaults to VITE_API_BASE_URL converted to ws/wss with /ws/connect.
VITE_WS_URL=wss://myaong-production-d3b8.up.railway.app/ws/connect
VITE_MQTT_BROKER_URL=ws://localhost:9001
VITE_STREAM_URL=

# ESP32 Wi-Fi setup
VITE_ESP32_SETUP_URL=http://192.168.4.1
VITE_ESP32_MQTT_HOST=auto

# Google OAuth client ID from Google Cloud Console.
# Leave empty to disable Google login until a real ID is issued.
VITE_GOOGLE_CLIENT_ID=

# EmailJS verification email settings.
# If all three are empty, the app can keep using the mock verification flow.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
