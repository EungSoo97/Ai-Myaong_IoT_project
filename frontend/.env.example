# Google OAuth — Google Cloud Console에서 발급한 웹 클라이언트 ID (무료)
# 사용법: 이 파일을 복사해 frontend/.env 로 저장하고 값을 채운 뒤 dev 서버 재시작
#   1) https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
#   2) "OAuth 2.0 클라이언트 ID"(애플리케이션 유형: 웹) 생성
#   3) 승인된 JavaScript 원본에 개발 주소 등록 (예: http://localhost:5173)
#   4) 발급된 ID를 아래에 입력 (형식: xxxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# EmailJS — 인증번호 메일 실제 발송 (무료 월 200건). https://www.emailjs.com
# 3개 모두 비어 있으면 화면에 코드를 표시하는 mock으로 자동 동작
#   1) Email Services 에서 Gmail 연결 → Service ID
#   2) Email Templates 생성 (To Email = {{email}}, 본문에 {{code}} 포함) → Template ID
#   3) Account → API Keys → Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
