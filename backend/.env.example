# Backend server
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./backend/aimyaong.sqlite3
SIMULATION_MODE=true
BACKEND_PUBLIC_URL=
BACKEND_PUBLIC_PORT=8000

# MQTT broker
MQTT_BROKER_HOST="e44ad0126d10454591f26ef086205935.s1.eu.hivemq.cloud"
MQTT_BROKER_PORT=8883
MQTT_USERNAME="Mz1004"
MQTT_PASSWORD="Mz10041004"
MQTT_USE_TLS=true
MQTT_TCP_NODELAY=true
MQTT_CONFIG_CHECK_INTERVAL=1
# Optional comma-separated topics to subscribe again after MQTT reconnect.
MQTT_SUBSCRIBE_TOPICS=
# Set true only if /api/device/register should wait for MQTT reconnect.
BACKEND_REQUIRE_MQTT_ON_DEVICE_REGISTER=false

# Camera stream
CAMERA_STREAM_URL=http://raspberrypi.local:8081/stream.mjpg
CAMERA_PROXY=false
STREAM_BASE_URL=
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=10

# Retention policy
ALERT_RETENTION_DAYS=30
VISION_MEDIA_RETENTION_DAYS=30
DETECTION_LOG_RETENTION_DAYS=30
ACTIVITY_SUMMARY_RETENTION_DAYS=365

# Raspberry Pi agent
PI_AGENT_BASE_URL=http://raspberrypi.local:8765
PI_AGENT_HTTP_PORT=8765

# Robot command transport: mqtt, pi_http, or local_serial for direct USB Arduino tests.
ROBOT_COMMAND_TRANSPORT=mqtt
SERIAL_PORT=auto
SERIAL_BAUD=115200
SERIAL_DEBUG=false
