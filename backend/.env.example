# Backend server
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./backend/aimyaong.sqlite3
SIMULATION_MODE=true

# MQTT broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Camera stream
CAMERA_STREAM_URL=http://raspberrypi.local:8080/stream.mjpg
CAMERA_PROXY=false
STREAM_BASE_URL=
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=10

# Raspberry Pi agent
PI_AGENT_BASE_URL=http://raspberrypi.local:8765
PI_AGENT_HTTP_PORT=8765
